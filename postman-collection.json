{
  "info": {
    "_postman_id": "openconsigplatform-credit-simulation",
    "name": "OpenConsigPlatform",
    "description": "Requests for the OpenConsigPlatform local Docker environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/actuator/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "actuator",
            "health"
          ]
        },
        "description": "Checks whether the application is running."
      },
      "response": []
    },
    {
      "name": "Credit",
      "item": [
        {
          "name": "Create Credit Simulation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cpf\": \"12345678900\",\n  \"monthlyIncome\": 5000.00,\n  \"requestedAmount\": 10000.00,\n  \"installments\": 24\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/credit/simulations",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "credit",
                "simulations"
              ]
            },
            "description": "Creates and persists an internal credit simulation."
          },
          "response": []
        },
        {
          "name": "Create Invalid Simulation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cpf\": \"12345678900\",\n  \"monthlyIncome\": 5000.00,\n  \"requestedAmount\": 10000.00,\n  \"installments\": 120\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/credit/simulations",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "credit",
                "simulations"
              ]
            },
            "description": "Example of validation failure: installments outside the allowed range."
          },
          "response": []
        }
      ]
    }
  ]
}
